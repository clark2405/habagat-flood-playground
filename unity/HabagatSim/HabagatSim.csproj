<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1 is what Unity consumes. Nothing in this library touches
         UnityEngine, so it builds and tests under plain dotnet today and drops
         into Assets/ unchanged later. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>HabagatSim</AssemblyName>
    <RootNamespace>Habagat</RootNamespace>
  </PropertyGroup>

</Project>
