# Unity serialises scenes, prefabs and settings as YAML, and git's default merge
# will happily produce a file that opens as a corrupt scene rather than a conflict.
# `unityyamlmerge` ships with the editor and understands the format; point git at it
# with, once per machine:
#
#   git config merge.unityyamlmerge.driver \
#     '"C:/Program Files/Unity/Hub/Editor/6000.3.20f1/Editor/Data/Tools/UnityYAMLMerge.exe" merge -p %O %A %B %A'
#
# Assets/Scenes/Habagat.unity is generated by `Habagat/Rebuild Play Scene`, so the
# other option for a conflict there is always to regenerate rather than merge.
*.unity   merge=unityyamlmerge eol=lf
*.prefab  merge=unityyamlmerge eol=lf
*.asset   merge=unityyamlmerge eol=lf
*.mat     merge=unityyamlmerge eol=lf
*.meta    merge=unityyamlmerge eol=lf

# Anything Unity treats as an opaque asset. Marked explicitly so git never tries to
# diff, merge or line-ending-convert it.
*.png  binary
*.jpg  binary
*.tga  binary
*.psd  binary
*.fbx  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.ttf  binary
*.otf  binary
*.dll  binary
*.exe  binary
